{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privacy Policy",
  "description": "Content for the Privacy Policy page: a plain text page with the site's fonts and styling. Layout is fixed by the template; each top-level property is one zone. Header, footer and crisis line come from site settings.",
  "type": "object",
  "additionalProperties": false,
  "x-cms": {
    "kind": "singleton",
    "route": "/privacy-policy",
    "template": "LegalPage",
    "zones": [
      "hero",
      "body",
      "meta"
    ]
  },
  "required": [
    "hero",
    "body",
    "seo"
  ],
  "properties": {
    "hero": {
      "type": "object",
      "title": "Hero",
      "additionalProperties": false,
      "x-cms": {
        "zone": "hero",
        "order": 1
      },
      "required": [
        "eyebrow",
        "heading"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Legal"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "default": "Privacy policy",
          "description": "The page's only H1."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date",
          "description": "Shown under the heading as \"Last updated\"."
        }
      }
    },
    "body": {
      "type": "object",
      "title": "Body",
      "additionalProperties": false,
      "x-cms": {
        "zone": "body",
        "order": 1
      },
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000,
          "description": "Use H2 and H3 only; the heading above is the H1.",
          "contentMediaType": "text/markdown",
          "x-ui": {
            "widget": "markdown",
            "toolbar": [
              "heading2",
              "heading3",
              "bold",
              "italic",
              "link",
              "bulletList",
              "numberedList"
            ]
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "title": "SEO",
      "additionalProperties": false,
      "x-cms": {
        "zone": "meta",
        "order": 1
      },
      "required": [
        "title",
        "description",
        "noindex"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "ogImage": {
          "$ref": "#/$defs/image"
        },
        "noindex": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "alt"
      ],
      "x-ui": {
        "widget": "image"
      },
      "properties": {
        "assetId": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "description": "Required for WCAG."
        },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
